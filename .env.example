# ==============================================================================
# QUOTEX SIGNAL & ASSISTED-TRADING BOT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: This file is a template. Real values go in `.env`, which is gitignored.
# NEVER paste live credentials, API keys, or session tokens (SSID) in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL SAFETY & EXECUTION GATES
# ------------------------------------------------------------------------------
# Enforce demo-account execution only. Real money trading is prohibited by default.
DEMO_ONLY=True

# Enable order execution layer. Default is False (Signal Only mode).
EXECUTION_ENABLED=False

# Exact confirmation phrase required at interactive runtime to unlock assisted execution.
CONFIRMATION_PHRASE=I_ACCEPT_THE_RISK

# ------------------------------------------------------------------------------
# 2. QUOTEX CREDENTIALS & SESSIONS
# ------------------------------------------------------------------------------
# Session SSID extracted from browser DevTools (Recommended approach).
# How to extract: DevTools (F12) -> Application -> Cookies -> 'https://quotex.com' -> 'ssid'
QUOTEX_SSID=your_ssid_here

# Email and Password (Fallback if SSID is not provided)
QUOTEX_EMAIL=your_email_here
QUOTEX_PASSWORD=your_password_here

# Comma-separated list of assets to monitor
ASSETS=EURUSD_otc,GBPUSD_otc,USDJPY_otc

# Candle timeframe in seconds (60 = 1 minute candles)
TIMEFRAME_SECONDS=60

# Days of historical candles to fetch for ML training
CANDLE_HISTORY_DAYS=60

# Maximum simultaneous active WebSocket connections (Max 5, recommended <=3)
MAX_CONCURRENT_STREAMS=3

# Default broker payout ratio if live rate query is unavailable
DEFAULT_PAYOUT=0.85

# ------------------------------------------------------------------------------
# 3. SIGNAL THRESHOLDS & ADAPTIVE ML
# ------------------------------------------------------------------------------
# Minimum ML model probability threshold required to qualify a signal (0.50 to 1.0)
SIGNAL_CONFIDENCE_THRESHOLD=0.65

# Minimum Expected Value (EV) percentage required (0.02 = 2% EV over break-even)
MIN_EXPECTED_VALUE=0.02

# Rolling retraining cycle interval in hours
RETRAIN_INTERVAL_HOURS=6

# Number of timestamped model checkpoints to retain on disk before purging
MODEL_PURGE_KEEP=5

# Directory where trained models are saved
MODEL_DIR=./models

# ------------------------------------------------------------------------------
# 4. RISK MANAGEMENT & UI PACING
# ------------------------------------------------------------------------------
# Stake amount per trade in currency units
TRADE_AMOUNT=1.0

# Circuit breaker: maximum trades allowed in a 24-hour period
MAX_DAILY_TRADES=20

# Circuit breaker: max loss percentage before automated shutdown (0.05 = 5%)
MAX_DAILY_LOSS_PCT=0.05

# Interaction delay range in milliseconds (simulates natural human pacing)
ACTION_DELAY_MIN_MS=150
ACTION_DELAY_MAX_MS=400

# Minimum cooldown period in seconds between executed trades
MIN_TRADE_GAP_SECONDS=30

# ------------------------------------------------------------------------------
# 5. TELEGRAM ALERTING
# ------------------------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat ID or Channel ID where alerts are delivered
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 6. WHATSAPP CLOUD API ALERTING (META OFFICIAL)
# ------------------------------------------------------------------------------
# System user access token from Meta Developers portal
WHATSAPP_API_TOKEN=

# Phone Number ID from WhatsApp App Dashboard
WHATSAPP_PHONE_NUMBER_ID=

# Recipient phone number with country code (e.g. +14155552671)
WHATSAPP_RECIPIENT=

# ------------------------------------------------------------------------------
# 7. LOGGING & BROWSER PERSISTENCE
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/quotex_bot.log
BROWSER_PROFILE_DIR=./browser_profile
